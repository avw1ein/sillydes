#
# Checks that the program carries the hardening of STRUCTURE.md section 12: that the build did what
# cmake/harden.cmake says, not just that the flags were passed.
#   ELF (Linux): position independent, non-executable stack, read-only relocations, bound at load,
#                stack protector, and IBT and shadow stack (x86-64) or BTI and PAC code (arm64).
#   PE (Windows): ASLR, high-entropy ASLR, DEP, and with MSVC control flow guard.
#   Mach-O (macOS): every architecture of the file is position independent and has the stack
#                protector; the signature is valid and carries the hardened runtime and no
#                get-task-allow entitlement; a universal build holds the architectures asked for.
#
#   cmake -DBINARY=<file> -DCOMPILER_ID=<id> [-DARCHS=<list>] [-DSIGNED=ON|OFF] -P check_hardening.cmake

function(fail what)
  message(FATAL_ERROR "${BINARY}: ${what}")
endfunction()

file(READ "${BINARY}" head HEX LIMIT 4096)
string(SUBSTRING "${head}" 0 8 magic)

if(magic STREQUAL "7f454c46")
  find_program(READELF readelf)
  if(NOT READELF)
    message(STATUS "hardening: readelf not found, nothing checked")
    return()
  endif()
  function(readelf_out out)
    execute_process(COMMAND "${READELF}" ${ARGN} "${BINARY}" OUTPUT_VARIABLE text RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      fail("readelf ${ARGN} failed")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
  endfunction()

  readelf_out(header -h)
  if(NOT header MATCHES "Type: +DYN")
    fail("not a position-independent executable")
  endif()
  readelf_out(segments -lW)
  if(NOT segments MATCHES "GNU_STACK[^\n]* RW  ")
    fail("the stack is executable or GNU_STACK is missing")
  endif()
  if(NOT segments MATCHES "GNU_RELRO")
    fail("no read-only relocations (GNU_RELRO)")
  endif()
  readelf_out(dynamic -dW)
  if(NOT dynamic MATCHES "BIND_NOW|FLAGS[^\n]*NOW")
    fail("symbols are not bound at load (-z now)")
  endif()
  readelf_out(symbols -sW)
  if(NOT symbols MATCHES "__stack_chk_fail")
    fail("no stack protector")
  endif()
  readelf_out(notes -n)
  if(header MATCHES "X86-64")
    if(NOT notes MATCHES "IBT" OR NOT notes MATCHES "SHSTK")
      fail("no IBT and SHSTK markers (-fcf-protection)")
    endif()
  elseif(header MATCHES "AArch64")
    # The GNU property note is only written when every input, the C runtime's too, carries it, which
    # Ubuntu's arm64 toolchain does not guarantee; so look for the landing pads in the code instead.
    find_program(OBJDUMP objdump)
    if(OBJDUMP)
      execute_process(COMMAND "${OBJDUMP}" -d "${BINARY}" OUTPUT_VARIABLE code RESULT_VARIABLE rc)
      if(NOT rc EQUAL 0 OR NOT code MATCHES "[ \t]bti[ \t]+[cjf]")
        fail("no BTI landing pads in the code (-mbranch-protection)")
      endif()
      if(NOT code MATCHES "[ \t]paciasp")
        fail("no pointer authentication in the code (-mbranch-protection)")
      endif()
    endif()
  endif()
  message(STATUS "hardening: ELF ok")

elseif(magic MATCHES "^4d5a")
  # PE: e_lfanew at 0x3C, then "PE\0\0", the 20-byte file header and the optional header, whose
  # DllCharacteristics (16 bits) sit at offset 70 of a PE32+ image.
  function(byte_at offset out)
    math(EXPR at "${offset} * 2")
    string(SUBSTRING "${head}" ${at} 2 b)
    math(EXPR v "0x${b}")
    set(${out} ${v} PARENT_SCOPE)
  endfunction()
  byte_at(60 b0)
  byte_at(61 b1)
  math(EXPR pe "${b0} + ${b1} * 256")
  math(EXPR chars_at "${pe} + 24 + 70")
  byte_at(${chars_at} lo)
  math(EXPR hi_at "${chars_at} + 1")
  byte_at(${hi_at} hi)
  math(EXPR chars "${lo} + ${hi} * 256")
  set(flags "0x20;high-entropy ASLR;0x40;ASLR (dynamic base);0x100;DEP (NX compatible)")
  if(COMPILER_ID STREQUAL "MSVC")
    list(APPEND flags "0x4000;control flow guard")
  endif()
  while(flags)
    list(POP_FRONT flags bit what)
    math(EXPR set "${chars} & ${bit}")
    if(set EQUAL 0)
      fail("the image has no ${what}")
    endif()
  endwhile()
  message(STATUS "hardening: PE ok (DllCharacteristics ${chars})")
elseif(magic STREQUAL "cffaedfe" OR magic MATCHES "^cafeba")
  # Thin Mach-O (64-bit, little endian) or universal ("fat") file.
  function(run out)
    execute_process(COMMAND ${ARGN} OUTPUT_VARIABLE text ERROR_VARIABLE more RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      fail("${ARGN} failed (${rc}): ${more}")
    endif()
    set(${out} "${text}${more}" PARENT_SCOPE)
  endfunction()

  run(archs lipo -archs "${BINARY}")
  string(STRIP "${archs}" archs)
  separate_arguments(archs)
  list(LENGTH archs count)
  if(ARCHS)
    set(want ${ARCHS})
    list(SORT want)
    set(have ${archs})
    list(SORT have)
    if(NOT want STREQUAL have)
      fail("architectures are '${archs}', not '${ARCHS}'")
    endif()
  endif()

  run(header otool -arch all -hv "${BINARY}")
  string(REGEX MATCHALL "[ \t]PIE" pie "${header}")
  list(LENGTH pie pies)
  if(NOT pies EQUAL count)
    fail("not every architecture (${archs}) is a position-independent executable")
  endif()
  run(symbols nm -arch all -u "${BINARY}")
  string(REGEX MATCHALL "___stack_chk_fail" guards "${symbols}")
  list(LENGTH guards guarded)
  if(NOT guarded EQUAL count)
    fail("not every architecture (${archs}) has the stack protector")
  endif()

  if(SIGNED)
    run(verified codesign --verify --strict --verbose=2 "${BINARY}")
    foreach(arch ${archs})
      run(info codesign -d -vv --arch ${arch} "${BINARY}")
      if(NOT info MATCHES "flags=0x[0-9a-f]+\\([^)]*runtime")
        fail("${arch}: the signature has no hardened runtime flag:\n${info}")
      endif()
      run(entitlements codesign -d --entitlements - --arch ${arch} "${BINARY}")
      if(entitlements MATCHES "get-task-allow")
        fail("${arch}: the entitlement get-task-allow lets any debugger attach")
      endif()
    endforeach()
  endif()
  message(STATUS "hardening: Mach-O ok (${archs})")
else()
  message(STATUS "hardening: not ELF, PE or Mach-O, nothing checked")
endif()
