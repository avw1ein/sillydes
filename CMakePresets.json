{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ci",
      "displayName": "Release, warnings are errors (what CI runs)",
      "inherits": "default",
      "cacheVariables": { "SILLYDES_WERROR": "ON" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SILLYDES_WERROR": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "debug", "configurePreset": "debug" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true, "verbosity": "verbose" } },
    { "name": "ci", "configurePreset": "ci", "output": { "outputOnFailure": true, "verbosity": "verbose" } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true, "verbosity": "verbose" } }
  ]
}
